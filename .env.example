# ==============================================================================
# Multi-PC Cloud Native Configuration Reference (.env.example)
# ==============================================================================
# NOTE: In this cloud-native architecture, creating a local .env file is OPTIONAL!
# On any machine authenticated via `gcloud auth login`, the application will
# automatically resolve all secrets from Google Cloud Secret Manager.
#
# If you have local keys you wish to synchronize to Google Cloud Secret Manager,
# you can define them here and run:
#   python sync_secrets.py --push-env .env
# ==============================================================================

# --- Google Cloud Project ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Cloud Storage Bucket for persistent memory & decoupled audit logs
GCS_BUCKET_NAME=your-gcp-project-id-korean-teacher-data

# --- Gemini API ---
# Secret Manager ID: gemini-api-key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- LINE Messaging API ---
# Secret Manager ID: korean-teacher-line-channel-secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# Secret Manager ID: korean-teacher-line-channel-access-token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Base URL for public webhook & TTS audio serving (Cloud Run URL)
BASE_URL=https://your-service-url.a.run.app

# --- Korean Local Search APIs (Optional) ---
# Secret Manager IDs: naver-client-id, naver-client-secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Secret Manager ID: kakao-rest-api-key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Secret Manager IDs: google-search-api-key, google-search-cx
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_CX=your_google_custom_search_cx
